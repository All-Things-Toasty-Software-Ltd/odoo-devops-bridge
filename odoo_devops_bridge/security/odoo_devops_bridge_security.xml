<odoo>
    <!-- DevOps Bridge Security Category -->
    <record id="module_category_odoo_devops_bridge" model="ir.module.category">
        <field name="name">DevOps Bridge</field>
        <field name="description">Manage external integrations with GitHub, GitLab, and YouTrack.
        </field>
        <field name="sequence">25</field>
    </record>

    <!-- DevOps Bridge Privilege -->
    <record id="res_groups_privilege_odoo_devops_bridge" model="res.groups.privilege">
        <field name="name">DevOps Bridge</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_odoo_devops_bridge"/>
    </record>

    <!-- User Group -->
    <record id="group_odoo_devops_bridge_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_odoo_devops_bridge"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <!-- Manager Group -->
    <record id="group_odoo_devops_bridge_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_odoo_devops_bridge"/>
        <field name="implied_ids" eval="[Command.link(ref('group_odoo_devops_bridge_user'))]"/>
    </record>

    <!-- Administrator Group -->
    <record id="group_odoo_devops_bridge_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_odoo_devops_bridge"/>
        <field name="implied_ids" eval="[Command.link(ref('group_odoo_devops_bridge_manager'))]"/>
        <field name="user_ids"
               eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- Record Rules -->
    <data noupdate="1">
        <!-- Personal Account Security: Users only see their own personal credentials -->
        <record id="odoo_devops_bridge_account_personal_rule" model="ir.access">
            <field name="name">Personal Account: User access own</field>
            <field name="model_id" ref="model_odoo_devops_bridge_account"/>
            <field name="group_id" ref="group_odoo_devops_bridge_user"/>
            <field name="operation">crud</field>
            <field name="domain">[('user_id', '=', user.id)]</field>
        </record>

        <!-- Admin Account Security: DevOps Admins can access all accounts (including bot accounts) -->
        <record id="odoo_devops_bridge_account_admin_rule" model="ir.access">
            <field name="name">Personal Account: Admin full access</field>
            <field name="model_id" ref="model_odoo_devops_bridge_account"/>
            <field name="group_id" ref="group_odoo_devops_bridge_admin"/>
            <field name="operation">crud</field>
            <field name="domain">[(1, '=', 1)]</field>
        </record>

        <!-- Multi-Company Restriction: DevOps Server -->
        <record id="odoo_devops_bridge_server_company_rule" model="ir.access">
            <field name="name">DevOps Server: Multi-Company Rule</field>
            <field name="model_id" ref="model_odoo_devops_bridge_server"/>
            <field name="operation">crud</field>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in',
                company_ids)]
            </field>
        </record>
    </data>
</odoo>