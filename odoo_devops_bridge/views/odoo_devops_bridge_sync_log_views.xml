<odoo>
    <!-- Sync Log List View -->
    <record id="view_odoo_devops_bridge_sync_log_list" model="ir.ui.view">
        <field name="name">odoo_devops_bridge.sync.log.list</field>
        <field name="model">odoo_devops_bridge.sync.log</field>
        <field name="arch" type="xml">
            <list string="DevOps Sync Logs" decoration-success="status == 'success'"
                  decoration-danger="status == 'failed'" decoration-warning="status == 'skipped'"
                  decoration-info="status == 'pending'">
                <field name="name"/>
                <field name="created_at"/>
                <field name="server_id"/>
                <field name="provider" widget="badge"/>
                <field name="direction" widget="badge"/>
                <field name="event_type"/>
                <field name="payload_preview"/>
                <field name="status" widget="badge" decoration-success="status == 'success'"
                       decoration-danger="status == 'failed'"
                       decoration-warning="status == 'skipped'"/>
                <button name="action_retry" type="object" string="Retry" class="btn-sm btn-link"
                        icon="fa-repeat" invisible="status == 'success'"/>
            </list>
        </field>
    </record>

    <!-- Sync Log Form View -->
    <record id="view_odoo_devops_bridge_sync_log_form" model="ir.ui.view">
        <field name="name">odoo_devops_bridge.sync.log.form</field>
        <field name="model">odoo_devops_bridge.sync.log</field>
        <field name="arch" type="xml">
            <form string="Synchronization Audit Record" create="false" edit="false">
                <header>
                    <button name="action_retry" type="object" string="Replay Event"
                            class="btn-primary" icon="fa-repeat" invisible="status == 'success'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="pending,success,failed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Success" bg_color="text-bg-success"
                            invisible="status != 'success'"/>
                    <widget name="web_ribbon" title="Failed" bg_color="text-bg-danger"
                            invisible="status != 'failed'"/>
                    <widget name="web_ribbon" title="Skipped" bg_color="text-bg-warning"
                            invisible="status != 'skipped'"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group name="meta_info" string="Metadata">
                            <field name="server_id" readonly="1"/>
                            <field name="provider" readonly="1"/>
                            <field name="direction" readonly="1"/>
                            <field name="event_type" readonly="1"/>
                            <field name="created_at" readonly="1"/>
                        </group>
                        <group name="status_info" string="Execution Outcome">
                            <field name="status" readonly="1"/>
                            <field name="payload_preview" readonly="1"/>
                        </group>
                    </group>

                    <div class="alert alert-danger" role="alert" invisible="not error_message">
                        <strong>Error Traceback:</strong>
                        <pre>
                            <field name="error_message" readonly="1"/>
                        </pre>
                    </div>

                    <notebook>
                        <page name="full_payload" string="Complete Payload">
                            <field name="payload_full" readonly="1" widget="ace"
                                   options="{'mode': 'json'}"/>
                        </page>
                        <page name="response_details" string="Response / Result">
                            <field name="response_preview" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Sync Log Search View -->
    <record id="view_odoo_devops_bridge_sync_log_search" model="ir.ui.view">
        <field name="name">odoo_devops_bridge.sync.log.search</field>
        <field name="model">odoo_devops_bridge.sync.log</field>
        <field name="arch" type="xml">
            <search string="Search Sync Logs">
                <field name="name"/>
                <field name="server_id"/>
                <field name="event_type"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <filter string="Success" name="success" domain="[('status', '=', 'success')]"/>
                <filter string="Inbound" name="inbound" domain="[('direction', '=', 'inbound')]"/>
                <filter string="Outbound" name="outbound"
                        domain="[('direction', '=', 'outbound')]"/>
                <group>
                    <filter string="Server" name="group_by_server" domain="[]"
                            context="{'group_by': 'server_id'}"/>
                    <filter string="Event Type" name="group_by_event" domain="[]"
                            context="{'group_by': 'event_type'}"/>
                    <filter string="Status" name="group_by_status" domain="[]"
                            context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_odoo_devops_bridge_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Audit Logs</field>
        <field name="res_model">odoo_devops_bridge.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_failed': 0}</field>
    </record>
</odoo>